---
import PlayButton from './PlayButton.astro';
import { TRIAL_DAYS } from '../config/site';

interface Props {
  from: string;
  title?: string;
  text?: string;
}
const {
  from,
  title = 'Your first streak starts today.',
  text = `Download Habit Tracker and try every feature free for ${TRIAL_DAYS} days. No account, no card, no ads.`,
} = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <PlayButton from={from} light />
    </div>
  </div>
</section>
