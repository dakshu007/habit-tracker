---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import { articleSchema, faqSchema, fmtDate, readingMinutes } from '../../lib/schema';
import { playLink, TRIAL_DAYS } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const related = [
  ...d.related.map((id) => posts.find((p) => p.id === id)).filter(Boolean),
  ...posts.filter((p) => p.id !== post.id && !d.related.includes(p.id)),
].slice(0, 3) as typeof posts;
const path = `/blog/${post.id}`;
const minutes = readingMinutes(post.body ?? '');
---
<Base
  title={d.seoTitle ?? d.title}
  description={d.description}
  type="article"
  published={d.date.toISOString()}
  modified={(d.updated ?? d.date).toISOString()}
  crumbs={[{ name: 'Blog', path: '/blog' }, { name: d.title, path }]}
  schema={[articleSchema({ title: d.title, description: d.description, path, image: '/og.png', published: d.date, modified: d.updated }), ...faqSchema(d.faq)]}
>
  <header class="article-hero">
    <div class="container">
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/blog">Blog</a></li><li>{d.category}</li></ol>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="post-meta">
        <span>By the Habit Tracker team</span>
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        <span>{minutes} min read</span>
      </p>
    </div>
  </header>

  <div class="container">
    <div class={`article-cover tint-${d.tint}`} aria-hidden="true"><img src={`/img/ill/${d.art}.webp`} alt="" width="320" height="320" loading="eager" /></div>
    <div class="article-layout">
      <article class="prose">
        <Content />
        <div class="card author-box">
          <img src="/img/icon.webp" alt="" width="54" height="54" loading="lazy" />
          <p><strong>Habit Tracker team.</strong> We build Habit Tracker, an Android app with illustrated habit cards, forgiving streaks and an AI coach. We write about the habit science we use every day.</p>
        </div>
      </article>
      <aside class="article-aside">
        {toc.length > 0 && (
          <nav class="card toc" aria-label="On this page">
            <p>On this page</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="card aside-cta">
          <img src="/img/icon.webp" alt="" width="64" height="64" loading="lazy" />
          <b>Track it in Habit Tracker</b>
          <p>Illustrated habit cards, streak freezes and an AI coach. {TRIAL_DAYS} days free.</p>
          <a class="btn btn-dark" href={playLink(`blog-aside-${post.id}`)} rel="noopener" data-download="blog-aside"><Icon name="Download" size={18} /> Download free</a>
        </div>
      </aside>
    </div>
  </div>

  <FaqList items={d.faq} />

  {related.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="section-head reveal"><h2>Keep reading</h2></div>
        <div class="post-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}

  <CtaBand from={`blog-band-${post.id}`} />
</Base>
