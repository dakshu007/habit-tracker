---
import '../styles/site.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingCta from '../components/FloatingCta.astro';
import { SITE } from '../config/site';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description?: string;
  /** Social card image, absolute path from the site root. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (Article, FAQPage, …). */
  schema?: Record<string, unknown>[];
  /** Breadcrumb trail after Home. */
  crumbs?: Crumb[];
  noindex?: boolean;
  /** Article dates, ISO. */
  published?: string;
  modified?: string;
}

const {
  title,
  description = SITE.defaultDescription,
  image = '/og.png',
  type = 'website',
  schema = [],
  crumbs = [],
  noindex = false,
  published,
  modified,
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: SITE.company,
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  email: SITE.email,
  contactPoint: { '@type': 'ContactPoint', email: SITE.email, contactType: 'customer support', availableLanguage: ['English', 'Hindi'] },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'en-IN',
  publisher: { '@id': `${SITE.url}/#org` },
};
const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.path, SITE.url).href,
      })),
    }
  : null;
const jsonLd = [org, website, ...(breadcrumb ? [breadcrumb] : []), ...schema];
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.company} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="google-site-verification" content={SITE.googleVerification} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f9fe" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href="/fonts/google-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Habit Tracker blog" href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_IN" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingCta />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
